{
  "name": "revisions-espacees",
  "productName": "Révisions espacées",
  "version": "1.0.0",
  "description": "Révisions espacées : flashcards, calendrier J0-J30, exercices et rappels",
  "author": "kaze667",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.kaze667.revisions",
    "productName": "Révisions espacées",
    "executableName": "Revisions",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "store.js", "rappels.js", "config.json", "app/**/*", "build/icon.png"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "Revisions-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Révisions espacées"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null,
      "artifactName": "Revisions-${version}-${arch}.${ext}"
    },
    "publish": [{ "provider": "github", "owner": "kaze667", "repo": "revisions", "releaseType": "release" }]
  }
}
